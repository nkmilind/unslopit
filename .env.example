ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase — for the human-editor interest waitlist (/api/interest)
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# service_role key (Supabase → Project Settings → API). Server-side ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Supabase creds for browser auth (magic-link sign-in). Safe to expose — RLS-protected.
# Base project origin (no /rest/v1) and the "anon public" key from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret that signs the anonymous free-edit counter cookie (/api/unslop, /api/meter).
# Any long random string. Generate one: `openssl rand -hex 32`
METER_SECRET=change-me-to-a-long-random-string
